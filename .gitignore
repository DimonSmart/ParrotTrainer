# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.vs/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio / Gradle build artifacts
/android/build/
/android/app/debug
/android/app/profile
/android/app/release

# Android native build intermediates
/android/app/.cxx/
/android/.kotlin/

# Vendored plugins supply the application source. Their examples, tests and
# release-maintenance files are not part of this application.
/third_party/*/example/
/third_party/*/test/
/third_party/*/gen/
/third_party/*/analysis_options.yaml
/third_party/*/distribution.sh
/third_party/*/tag.sh

# Release signing credentials and keystores
/android/key.properties
*.jks
*.keystore
